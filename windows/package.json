{
  "name": "diary",
  "productName": "日記",
  "version": "1.0.0",
  "description": "可愛的日記 App",
  "main": "main.js",
  "author": "hixuanye",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.hixuanye.diary",
    "productName": "日記",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "vault.js",
      "app/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "日記",
      "runAfterFinish": true
    },
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "devDependencies": {
    "electron": "^44.7.1",
    "electron-builder": "^26.15.3"
  },
  "allowScripts": {
    "electron@44.7.2": true
  }
}

