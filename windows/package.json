{
  "name": "diary",
  "productName": "日記",
  "version": "1.0.0",
  "description": "可愛的日記 App",
  "main": "main.js",
  "author": "hixuanye",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.hixuanye.diary",
    "productName": "日記",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "vault.js",
      "app/**"
    ],
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "electron": "^44.7.1",
    "electron-builder": "^25.1.8"
  },
  "allowScripts": {
    "electron@44.7.2": true
  }
}

